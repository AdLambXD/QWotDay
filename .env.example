# 复制为 .env.local 后填写；不要提交到仓库
# QQ 空间登录态 Cookie：F12 → 网络 → 任意 user.qzone.qq.com 请求 → 请求标头里的 cookie
QZONE_COOKIE="uin=o123456789; skey=@xxxxxxxx; p_skey=xxxxxxxx; pt4_token=xxxxxxxx"

# 可选：Cookie 里解析不出 QQ 号时手动填写
QZONE_UIN=

# 可选：文案模板，留空使用默认值，占位符见 README
POST_TEMPLATE=
# 可选：话题标签，填 - 表示不显示
POST_TAG=#每日一言
# 可选：一言分类，逗号分隔；all 表示不限
HITOKOTO_CATEGORIES=d,i,k
# 可选：回读校验失败时是否让任务报错
STRICT_VERIFY=false
